// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

// MySQL : préférez une URL du type
// mysql://user:pass@host:3306/db?charset=utf8mb4
// pour éviter les accents corrompus en base (latin1).
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  seller
  admin
  superadmin
}

enum ProductState {
  new
  old
}

enum ValidationStatus {
  pending
  approved
  rejected
}

model User {
  id                 Int       @id @default(autoincrement())
  fullName           String?   @map("full_name")
  email              String    @unique @db.VarChar(254)
  password           String
  phone              String?
  city               String?
  registrationNumber String?   @map("registration_number")
  country            String?
  companyName        String?   @map("company_name")
  neighborhood       String?
  isValidated        Boolean   @default(false) @map("is_validated")
  role               UserRole  @default(customer)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  roles              Role[]    @relation("UserRoles")
  products           Product[] @relation("SellerProducts")
  comments           Comment[]
  orders             Order[]

  @@map("users")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  users       User[]       @relation("UserRoles")
  permissions Permission[] @relation("RolePermissions")

  @@map("roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  group     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles     Role[]   @relation("RolePermissions")

  @@map("permissions")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  url       String
  parentId  Int?      @map("parent_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subCategories  Category[] @relation("CategoryHierarchy")
  products       Product[]
  brands         Brand[]

  @@map("categories")
}

model Brand {
  id         Int      @id @default(autoincrement())
  name       String
  url        String
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category   Category @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@map("brands")
}

model Product {
  id               Int              @id @default(autoincrement())
  name             String
  slug             String           @unique
  cta              String?
  state            ProductState     @default(new)
  validationStatus ValidationStatus @default(pending) @map("validation_status")
  rejectionReason  String?          @map("rejection_reason")
  discount         Decimal          @default(0) @db.Decimal(10, 2)
  features         Json?
  categoryId       Int              @map("category_id")
  brandId          Int?             @map("brand_id")
  sellerId         Int?             @map("seller_id")
  warranty         String?          @default("1 mois")
  description      String           @db.Text
  price            Decimal          @db.Decimal(10, 2)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  category   Category  @relation(fields: [categoryId], references: [id])
  brand      Brand?    @relation(fields: [brandId], references: [id])
  seller     User?     @relation("SellerProducts", fields: [sellerId], references: [id])
  medias     Media[]
  comments   Comment[]
  promotions Promotion[]
  orders     Order[]

  @@map("products")
}

model Media {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  type      String   // Using String to match MediaType enum if needed, or define enum
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product  @relation(fields: [productId], references: [id])

  @@map("media")
}

model Comment {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  userId    Int?     @map("user_id")
  parentId  Int?     @map("parent_id")
  comment   String   @db.Text
  user      String
  isActive  Boolean  @default(true) @map("is_active")
  ip        String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product  @relation(fields: [productId], references: [id])
  author    User?    @relation(fields: [userId], references: [id])
  parent    Comment? @relation("CommentHierarchy", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentHierarchy")

  @@map("comments")
}

model Order {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  userId       Int?     @map("user_id")
  customerName String   @map("customer_name")
  city         String?
  phoneNumber  String   @map("phone_number")
  status       String   @default("pending")
  quantity     Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product      Product  @relation(fields: [productId], references: [id])
  customer     User?    @relation(fields: [userId], references: [id])

  @@map("orders")
}

model Promotion {
  id              Int      @id @default(autoincrement())
  productId       Int      @map("product_id")
  discountPercent Float    @map("discount_percent")
  url             String
  promoLabel      String?  @map("promo_label")
  promoStartDate  DateTime @map("promo_start_date")
  promoEndDate    DateTime @map("promo_end_date")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  product         Product  @relation(fields: [productId], references: [id])

  @@map("promotions")
}

model Banner {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  image       String
  link        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

model Partner {
  id        Int      @id @default(autoincrement())
  image     String
  label     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("partners")
}
