  // ─── Promotions CRUD ─────────────────────────────────────────────────────

  @Post('/dashboard/promotions/create')
  @UseInterceptors(FileInterceptor('image'))
  async createPromotion(@Res() res: Response, @Body() body: any, @UploadedFile() file: Express.Multer.File) {
    try {
      const productId = body.productId;
      const promoLabel = body.promoLabel;
      const discountPercent = body.discountPercent;
      const promoStartDate = body.promoStartDate;
      const promoEndDate = body.promoEndDate;
      
      console.log('Données reçues:', { productId, promoLabel, discountPercent, promoStartDate, promoEndDate });
      console.log('Fichier reçu:', file);
      
      // Validation : productId est obligatoire selon le schéma
      if (!productId) {
        return this.inertia.render('admin/promotions/index', {
          promos: await this.prisma.promotion.findMany({ include: { product: true } }),
          notification: {
            type: 'error',
            message: 'Le produit est obligatoire pour créer une promotion'
          }
        });
      }
      
      let imageUrl = '/uploads/promotions/default-promotion.jpg';
      
      // Traiter l'upload d'image si fourni
      if (file && file.filename) {
        imageUrl = `/uploads/promotions/${file.filename}`;
        console.log('Image uploadée:', imageUrl);
      }
      
      await this.prisma.promotion.create({
        data: {
          productId: parseInt(productId),
          promoLabel: promoLabel || 'Promotion',
          discountPercent: parseFloat(discountPercent) || 0,
          url: imageUrl,
          promoStartDate: promoStartDate ? new Date(promoStartDate) : new Date(),
          promoEndDate: promoEndDate ? new Date(promoEndDate) : new Date(Date.now() + 30 * 24 * 60 * 60 * 1000),
        }
      });
      
      console.log('Promotion créée avec succès');
      
      // Retourner une réponse JSON simple au lieu d'une redirection Inertia
      res.status(200).json({
        success: true,
        message: 'Promotion créée avec succès',
        promotion: {
          productId: parseInt(productId),
          promoLabel: promoLabel || 'Promotion',
          discountPercent: parseFloat(discountPercent) || 0,
          url: imageUrl,
          promoStartDate: promoStartDate ? new Date(promoStartDate) : new Date(),
          promoEndDate: promoEndDate ? new Date(promoEndDate) : new Date(Date.now() + 30 * 24 * 60 * 60 * 1000),
        }
      });
    } catch (error) {
      console.error('Erreur lors de la création de la promotion:', error);
      return this.inertia.render('admin/promotions/index', {
        promos: await this.prisma.promotion.findMany({ include: { product: true } }),
        notification: {
          type: 'error',
          message: `Erreur: ${error.message || 'Erreur lors de la création'}`
        }
      });
    }
  }

  @Post('/dashboard/promotions/edit/:id')
  @UseInterceptors(FileInterceptor('image'))
  async updatePromotion(@Res() res: Response, @Param('id') id: string, @Body() body: any, @UploadedFile() file: Express.Multer.File) {
    try {
      const productId = body.productId;
      const promoLabel = body.promoLabel;
      const discountPercent = body.discountPercent;
      const promoStartDate = body.promoStartDate;
      const promoEndDate = body.promoEndDate;
      
      // Récupérer la promotion existante
      const existingPromotion = await this.prisma.promotion.findUnique({
        where: { id: parseInt(id) }
      });
      
      if (!existingPromotion) {
        return this.inertia.render('admin/promotions/index', {
          promos: await this.prisma.promotion.findMany({ include: { product: true } }),
          notification: {
            type: 'error',
            message: 'Promotion non trouvée'
          }
        });
      }
      
      let imageUrl = existingPromotion.url;
      
      // Traiter l'upload d'image si fourni
      if (file && file.filename) {
        imageUrl = `/uploads/promotions/${file.filename}`;
        console.log('Image uploadée:', imageUrl);
      }
      
      await this.prisma.promotion.update({
        where: { id: parseInt(id) },
        data: {
          productId: productId ? parseInt(productId) : existingPromotion.productId,
          promoLabel,
          discountPercent: parseFloat(discountPercent) || existingPromotion.discountPercent,
          url: imageUrl,
          promoStartDate: promoStartDate ? new Date(promoStartDate) : existingPromotion.promoStartDate,
          promoEndDate: promoEndDate ? new Date(promoEndDate) : existingPromotion.promoEndDate,
        }
      });
      
      return res.status(200).json({
        success: true,
        message: 'Promotion modifiée avec succès'
      });
    } catch (error) {
      console.error('Erreur lors de la modification de la promotion:', error);
      return res.status(500).json({
        success: false,
        message: `Erreur: ${error.message || 'Erreur lors de la modification'}`
      });
    }
  }

  @Delete('/dashboard/promotions/delete/:id')
  async deletePromotion(@Res() res: Response, @Param('id') id: string) {
    try {
      await this.prisma.promotion.delete({ where: { id: parseInt(id) } });
      
      return res.status(200).json({
        success: true,
        message: 'Promotion supprimée avec succès'
      });
    } catch (error) {
      console.error('Erreur lors de la suppression de la promotion:', error);
      return res.status(500).json({
        success: false,
        message: `Erreur: ${error.message || 'Erreur lors de la suppression'}`
      });
    }
  }

