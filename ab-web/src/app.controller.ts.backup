  @Get()
  async index(@Res() res: Response, @Req() req: any) {
    try {
      const [products, categories, banners, partners] = await Promise.all([
        this.productsService.findAll(),
        this.categoriesService.findAll(),
        this.prisma.banner.findMany(),
        this.prisma.partner.findMany(),
      ]);
      
      // Vérifier si l'utilisateur est authentifié
      let authUser = null;
      let authRoles = [];
      
      if (req.authenticatedUser) {
        authUser = {
          ...req.authenticatedUser,
          isValidated: req.authenticatedUser.isValidated || false
        };
        authRoles = req.userRoles || [];
      }
      
      // Données de test si la base est vide
      const testData = {
        products: products.length > 0 ? products : [
          {
            id: 1,
            name: "Produit test 1",
            price: 1000,
            description: "Description du produit test",
            category: { id: 1, name: "Catégorie test" },
            brand: { id: 1, name: "Marque test" },
            medias: []
          }
        ],
        categories: categories.length > 0 ? categories : [
          { id: 1, name: "Catégorie test", subCategories: [] }
        ],
        banners: banners.length > 0 ? banners : [
          {
            id: 1,
            title: "Bannière test",
            description: "Description de la bannière test",
            image: "https://auto-cdn.uvatis.com/logo.png"
          }
        ],
        partners: partners.length > 0 ? partners : [
          { id: 1, name: "Partenaire test", logo: "https://auto-cdn.uvatis.com/logo.png" }
        ],
        auth: {
          user: authUser,
          roles: authRoles
        },
        // Ajouter aussi user au niveau racine pour compatibilité
        user: authUser,
        roles: authRoles
      };
      
      return this.inertia.render('home', testData);
    } catch (error) {
      console.error('Erreur dans index:', error);
      return this.inertia.render('home', {
        products: [],
        categories: [],
        banners: [],
        partners: [],
        auth: {
          user: null,
          roles: []
        }
      });
    }
  }

