{
  "name": "ab-auto-nestjs",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npx nest build && npx vite build && npx prisma generate && npx prisma db seed",
    "dev": "node scripts/dev.js",
    "start": "nest start",
    "db:seed": "npx prisma db seed",
    "seed": "npx prisma db seed",
    "seed:permissions": "node scripts/update-permissions.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:seed": "npx prisma db seed",
    "seed": "npx prisma db seed",
    "postinstall": "node -e \"const fs = require('fs'); const path = 'node_modules/nestjs-inertia/package.json'; if (fs.existsSync(path)) { const pkg = fs.readFileSync(path, 'utf8'); fs.writeFileSync(path, pkg.replace('dist/index.js', 'dist/src/index.js')); }\""
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/mdi": "^1.2.3",
    "@inertiajs/vue3": "^3.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
